# Copy to .env and fill in. The app runs WITHOUT a key (extractive fallback),
# but a key enables real LLM generation + the agent's grading/verification steps.

# Choose a provider: "openai" (Groq/OpenAI/Azure — anything OpenAI-compatible)
# or "anthropic" (Claude via the native Anthropic SDK).
LLM_PROVIDER=openai

# --- Option A: Groq (free, OpenAI-compatible) — default ---
# Key: https://console.groq.com/keys
LLM_API_KEY= 
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Anthropic Claude ---
# Set LLM_PROVIDER=anthropic, then:
#   LLM_API_KEY=sk-ant-...            (https://console.anthropic.com/)
#   LLM_MODEL=claude-3-5-sonnet-latest
#   (LLM_BASE_URL is ignored for the anthropic provider)

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=1024

# Embedding backend: "st" (sentence-transformers) or "tfidf" (offline fallback)
EMBEDDING_BACKEND=st
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store backend: "faiss" (default) or "chroma" (ChromaDB)
VECTOR_BACKEND=faiss

# Retrieval
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Regression-gate thresholds for GET /eval-check (used by the n8n monitor in
# automation/). If a sampled eval run scores below these, the endpoint
# reports pass=false.
EVAL_GROUNDED_THRESHOLD=0.8
EVAL_FAITHFULNESS_THRESHOLD=0.75
EVAL_HIT_RATE_THRESHOLD=0.6
